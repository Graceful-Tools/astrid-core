  "palette": {
    "list": ["#EF4444", "#F97316", "#EAB308", "#22C55E", "#06B6D4", "#3B82F6", "#8B5CF6", "#EC4899"],
    "tradeoff": ["#CC0000", "#E06666", "#FFD966", "#93C47D", "#38761D"],
    "tradeoff-text": ["#FFFFFF", "#111827", "#111827", "#111827", "#FFFFFF"]
  },
  "space": [2, 4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radius": { "sm": 6, "md": 8, "lg": 12, "xl": 16 },
  "shadow": {
    "sm": { "y": 1, "blur": 2, "alpha": 0.05 },
    "md": { "y": 1, "blur": 3, "alpha": 0.1 },
    "lg": { "y": 10, "blur": 15, "alpha": 0.1 }
  },
  "type": {
    "comfortable": {
      "title1": { "size": 34, "weight": 700 },
      "title2": { "size": 28, "weight": 700 },
      "title3": { "size": 22, "weight": 600 },
      "headline": { "size": 17, "weight": 600 },
      "body": { "size": 17, "weight": 400 },
      "callout": { "size": 16, "weight": 400 },
      "subheadline": { "size": 15, "weight": 400 },
      "footnote": { "size": 13, "weight": 400 },
      "caption1": { "size": 12, "weight": 400 },
      "caption2": { "size": 11, "weight": 400 },
      "row-title": { "size": 19, "weight": 500 }
    },
    "compact": {
      "row-title": { "size": 14, "weight": 500 },
      "row-meta": { "size": 11, "weight": 400 },
      "label": { "size": 11, "weight": 400 },
      "detail-body": { "size": 13, "weight": 400 }
    }
  },
  "motion": {
    "hover": { "ms": 100, "ease": "ease-out" },
    "press": { "ms": 100, "ease": "ease-in-out" },
    "fast": { "ms": 150, "ease": "ease-out" },
    "medium": { "ms": 220, "ease": "ease-in-out" },
    "panel": { "ms": 300, "ease": "ease-out" },
    "drawer": { "ms": 300, "ease": "cubic-bezier(0.25, 0.46, 0.45, 0.94)" },
    "spring": { "ms": 280, "damping": 0.85 },
    "panel-spring": { "ms": 340, "damping": 0.85 },
    "drawer-spring": { "ms": 250, "damping": 0.85 }
  },
  "size": {
    "comfortable": {
      "leading-control": 34,
      "selection-outline": 2.5,
      "hit-target": 44
    },
    "compact": {
      "leading-control": 17,
      "leading-control-detail": 19,
      "selection-outline": 1.5
    },
    "repeat-frame-scale": 1.0,
    "repeat-frame-inner-scale": 1.0,
    "hairline": 0.5
  },
  "layout": {
    "comfortable": {
      "row-min-height": 76,
      "row-padding-x": 16,
      "row-padding-y": 14,
      "row-gap": 12,
      "row-radius": 8,
      "detail-icon-column": 62,
      "detail-label-column": 80,
      "subtask-indent": 16,
      "board-card-radius": 8,
      "board-column-radius": 12,
      "detail-panel-radius": 16
    },
    "compact": {
      "row-min-height": 52,
      "row-padding-x": 12,
      "row-padding-y": 9,
      "row-gap": 12,
      "row-radius": 8,
      "detail-icon-column": 29,
      "subtask-indent": 16,
      "board-card-radius": 6,
      "board-column-radius": 8,
      "detail-panel-radius": 14,
      "detail-panel-min-width": 380,
      "sidebar-min-width": 240
    },
    "three-column-breakpoint": 1100
  },
  "markdown": {
    "tradeoff-cell-min": 84,
    "tradeoff-cell-max": 150,
    "tradeoff-gap": 3,
    "tradeoff-cell-radius": 4,
    "tradeoff-swatch": 10,
    "decision-card-radius": 10,
    "decision-badge": 24,
    "blockquote-bar": 3
