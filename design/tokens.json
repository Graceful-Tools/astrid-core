  "state": {
    "disabled-opacity": 0.5,
    "completed-mark-opacity": 0.5,
    "press-scale": 0.98,
    "selection-outline-opacity": 0.55,
    "complete-pop-scale": 1.28,
    "drawer-width-fraction": 0.85,
    "drawer-sidebar-scale": 0.95,
    "drawer-sidebar-opacity": 0.8,
    "subtask-max-depth": 4
  }
