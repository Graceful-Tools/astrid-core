# Normalise to LF in the repository; Git checks out the platform's native endings.
* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.mjs     text eol=lf
*.yml     text eol=lf

# PowerShell and the .NET project files are read by Windows tooling; keep them CRLF.
*.ps1     text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf

*.png     binary
*.ico     binary
*.pfx     binary
